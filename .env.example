# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (default: llama-3.3-70b-versatile, fallback: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Investigation Execution Limits
FAULTLINE_AGENT_TIMEOUT_SECONDS=60
FAULTLINE_OVERALL_TIMEOUT_SECONDS=300
FAULTLINE_MAX_RETRIES=3
FAULTLINE_MAX_TOOL_CALLS_PER_AGENT=10
FAULTLINE_MAX_FILE_READ_BYTES=65536
FAULTLINE_MAX_TOTAL_MODEL_CALLS=20
# FAULTLINE_MAX_TOTAL_TOKENS=50000

